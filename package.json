{
  "name": "@i-am-saebyeok/component-workbench",
  "version": "0.1.2",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "Service-local component catalog tooling with web previews, MCP, and BDD documentation.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-am-saebyeok/component-workbench.git"
  },
  "bin": {
    "component-workbench": "dist/src/cli.js"
  },
  "files": [
    "dist/src/",
    "dist/web/",
    "web/index.html",
    "web/styles.css",
    "templates/",
    "schema/",
    "docs/verification.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run typecheck && tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "qa:browser": "node test/browser/qa.js",
    "verify:install": "node test/verify-install.js",
    "schema": "npm run build && node dist/scripts/write-schema.js",
    "openspec:validate": "openspec validate --all --strict --no-interactive"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "smol-toml": "1.9.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.12.0",
    "@types/three": "0.187.0",
    "playwright-core": "1.62.1",
    "typescript": "7.1.0-beta"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
