{
  "title": "component-workbench catalog",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "revision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "intended_uses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "avoid_uses": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bdd": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)*\\.feature$"
            }
          },
          "preview": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "box"
                  },
                  "dimensions_m": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "number",
                        "exclusiveMinimum": 0
                      }
                    ],
                    "items": false,
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "required": [
                  "type",
                  "dimensions_m"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "html"
                  },
                  "src": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)*\\.html$"
                  }
                },
                "required": [
                  "type",
                  "src"
                ],
                "additionalProperties": false
              }
            ]
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "material": {
                  "type": "object",
                  "properties": {
                    "base_color_srgb_hex": {
                      "type": "string",
                      "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "roughness": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "metallic": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "base_color_srgb_hex",
                    "roughness",
                    "metallic"
                  ],
                  "additionalProperties": false
                },
                "preview": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "box"
                        },
                        "dimensions_m": {
                          "type": "array",
                          "prefixItems": [
                            {
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            {
                              "type": "number",
                              "exclusiveMinimum": 0
                            },
                            {
                              "type": "number",
                              "exclusiveMinimum": 0
                            }
                          ],
                          "items": false,
                          "minItems": 3,
                          "maxItems": 3
                        }
                      },
                      "required": [
                        "type",
                        "dimensions_m"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "const": "html"
                        },
                        "src": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(?:\\/[A-Za-z0-9_-][A-Za-z0-9._-]*)*\\.html$"
                        }
                      },
                      "required": [
                        "type",
                        "src"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "name"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "intended_uses",
          "avoid_uses",
          "bdd",
          "variants"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "revision",
    "components"
  ],
  "additionalProperties": false
}
